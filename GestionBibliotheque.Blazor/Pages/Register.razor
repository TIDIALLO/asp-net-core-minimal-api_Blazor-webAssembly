@page "/register"
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@using GestionBibliotheque.Blazor.Models;
@using Microsoft.AspNetCore.Components.Forms ;

<h3 class="text-center">Register</h3>

    <div class="d-flex justify-content-center mt-4">
        <div class="col-md-4 p-4 border rounded" style="height: 350px;">
        <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="username" class="mb-2">Username:</label>
                <InputText id="username" class="form-control form-control-sm mb-3" style="height: 40px; " @bind-Value="registerModel.Username" />
            </div>

            <div class="form-group">
                <label for="email" class="mb-2">Email:</label>
                <InputText id="email" class="form-control form-control-sm mb-3" style="height: 40px;" @bind-Value="registerModel.Email" />
            </div>

            <div class="form-group">
                <label for="password" class="mb-2">Password:</label>
                <InputText id="password" class="form-control form-control-sm mb-3" style="height: 40px;" @bind-Value="registerModel.Password" type="password" />
            </div>

            <button type="submit" class="btn btn-primary btn-block mt-4">Register</button>
        </EditForm>
    </div>
</div>

@code {
    private UserDTO registerModel = new UserDTO();

    private async Task HandleRegister()
    {
        var response = await HttpClient.PostAsJsonAsync("register", registerModel);
        if (response.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo("/login");
        }
    }
}